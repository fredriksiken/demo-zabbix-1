	<target name="prepare-frontend-postgresql-fixtures" depends="create-configs" if="frontend.default_postgresql_bare_shell">
		<echo message="Checking default PostgreSQL frontend fixture readiness for ${dbname}."/>
		<exec executable="psql" failonerror="off" resultproperty="frontend.postgresql.database_probe_exit"
				outputproperty="frontend.postgresql.database_probe_output">
			<env key="PGPASSWORD" value="${dbpassword}"/>
			<arg value="-q"/>
			<arg value="-h"/>
			<arg value="${dbhost}"/>
			<arg value="-p"/>
			<arg value="${dbport}"/>
			<arg value="-U"/>
			<arg value="${dbuser}"/>
			<arg value="-d"/>
			<arg value="postgres"/>
			<arg value="-At"/>
			<arg value="--set"/>
			<arg value="ON_ERROR_STOP=1"/>
			<arg value="-c"/>
			<arg value="select 1 from pg_database where datname = '${dbname}'"/>
		</exec>
		<condition property="frontend.postgresql.database_exists">
			<and>
				<equals arg1="${frontend.postgresql.database_probe_exit}" arg2="0"/>
				<contains string="${frontend.postgresql.database_probe_output}" substring="1"/>
			</and>
		</condition>
		<exec executable="psql" failonerror="off" resultproperty="frontend.postgresql.settings_probe_exit">
			<env key="PGPASSWORD" value="${dbpassword}"/>
			<arg value="-q"/>
			<arg value="-h"/>
			<arg value="${dbhost}"/>
			<arg value="-p"/>
			<arg value="${dbport}"/>
			<arg value="-U"/>
			<arg value="${dbuser}"/>
			<arg value="-d"/>
			<arg value="${dbname}"/>
			<arg value="-At"/>
			<arg value="--set"/>
			<arg value="ON_ERROR_STOP=1"/>
			<arg value="-c"/>
			<arg value="select count(*) from settings;"/>
		</exec>
		<condition property="frontend.postgresql.settings_queryable">
			<and>
				<isset property="frontend.postgresql.database_exists"/>
				<equals arg1="${frontend.postgresql.settings_probe_exit}" arg2="0"/>
			</and>
		</condition>
		<condition property="frontend.postgresql.fixtures_ready">
			<and>
				<isset property="frontend.postgresql.database_exists"/>
				<isset property="frontend.postgresql.settings_queryable"/>
			</and>
		</condition>
		<condition property="frontend.postgresql.skip_bootstrap">
			<and>
				<isset property="frontend.postgresql.fixtures_ready"/>
				<not>
					<isset property="frontend.clean_postgresql_frontend_fixtures_required"/>
				</not>
			</and>
		</condition>
		<exec executable="psql" failonerror="off" resultproperty="frontend.postgresql.createdb_probe_exit"
				outputproperty="frontend.postgresql.createdb_probe_output">
			<env key="PGPASSWORD" value="${dbpassword}"/>
			<arg value="-q"/>
			<arg value="-h"/>
			<arg value="${dbhost}"/>
			<arg value="-p"/>
			<arg value="${dbport}"/>
			<arg value="-U"/>
			<arg value="${dbuser}"/>
			<arg value="-d"/>
			<arg value="postgres"/>
			<arg value="-At"/>
			<arg value="--set"/>
			<arg value="ON_ERROR_STOP=1"/>
			<arg value="-c"/>
			<arg value="select case when rolcreatedb then '1' else '0' end from pg_roles where rolname = current_user"/>
		</exec>
		<condition property="frontend.postgresql.role_can_createdb">
			<and>
				<equals arg1="${frontend.postgresql.createdb_probe_exit}" arg2="0"/>
				<contains string="${frontend.postgresql.createdb_probe_output}" substring="1"/>
			</and>
		</condition>
		<antcall target="reuse-frontend-postgresql-fixtures" inheritAll="true"/>
		<antcall target="bootstrap-frontend-postgresql-fixtures" inheritAll="true"/>
	</target>

	<target name="reuse-frontend-postgresql-fixtures" if="frontend.postgresql.skip_bootstrap">
		<echo message="Default PostgreSQL frontend fixtures already exist for ${dbname}; skipping bootstrap."/>
	</target>

	<target name="bootstrap-frontend-postgresql-fixtures"
			if="frontend.default_postgresql_bare_shell" unless="frontend.postgresql.skip_bootstrap">
		<condition property="frontend.postgresql.bootstrap_message"
				value="Resetting default PostgreSQL frontend fixtures for ${dbname} before the shared documentation-link rerun."
				else="Default PostgreSQL frontend fixtures are missing or incomplete for ${dbname}; bootstrapping schema and Selenium fixtures.">
			<isset property="frontend.clean_postgresql_frontend_fixtures_required"/>
		</condition>
		<echo message="${frontend.postgresql.bootstrap_message}"/>
		<antcall target="make-dbschema" inheritAll="true"/>
		<antcall target="create-db-postgresql-via-role" inheritAll="true"/>
		<antcall target="create-db-postgresql-via-admin" inheritAll="true"/>
		<antcall target="load-frontend-postgresql-fixtures" inheritAll="true"/>
	</target>

