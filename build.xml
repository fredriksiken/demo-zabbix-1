	<target name="create-db-postgresql-via-admin" unless="frontend.postgresql.role_can_createdb">
		<exec executable="sudo" failonerror="off" resultproperty="frontend.postgresql.admin_probe_exit">
			<arg value="-n"/>
			<arg value="-u"/>
			<arg value="postgres"/>
			<arg value="psql"/>
			<arg value="-d"/>
			<arg value="postgres"/>
			<arg value="-Atqc"/>
			<arg value="select current_user;"/>
		</exec>
		<fail message="Default PostgreSQL bootstrap requires passwordless sudo access to the postgres OS account when ${dbuser} cannot create ${dbname}.">
			<condition>
				<not>
					<equals arg1="${frontend.postgresql.admin_probe_exit}" arg2="0"/>
				</not>
				</condition>
			</fail>
		<exec executable="sudo" failonerror="on">
			<arg value="-n"/>
			<arg value="-u"/>
			<arg value="postgres"/>
			<arg value="psql"/>
			<arg value="-d"/>
			<arg value="postgres"/>
			<arg value="--set"/>
			<arg value="ON_ERROR_STOP=1"/>
			<arg value="-c"/>
			<arg value="select pg_terminate_backend(pid) from pg_stat_activity where datname = '${dbname}' and pid &lt;&gt; pg_backend_pid()"/>
		</exec>
		<exec executable="sudo" failonerror="on">
			<arg value="-n"/>
			<arg value="-u"/>
			<arg value="postgres"/>
			<arg value="psql"/>
			<arg value="-d"/>
			<arg value="postgres"/>
			<arg value="--set"/>
			<arg value="ON_ERROR_STOP=1"/>
			<arg value="-c"/>
			<arg value="drop database if exists ${dbname}"/>
		</exec>
		<exec executable="sudo" failonerror="on">
			<arg value="-n"/>
			<arg value="-u"/>
			<arg value="postgres"/>
			<arg value="psql"/>
			<arg value="-d"/>
			<arg value="postgres"/>
			<arg value="--set"/>
			<arg value="ON_ERROR_STOP=1"/>
			<arg value="-c"/>
			<arg value="create database ${dbname} OWNER ${dbuser} ENCODING 'UTF8' TEMPLATE template0"/>
		</exec>
		<antcall target="load-db-postgresql-base" inheritAll="true"/>
	</target>

