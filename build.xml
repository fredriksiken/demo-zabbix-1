<?xml version="1.0" encoding="UTF-8"?>
<project name="Zabbix" default="build" basedir=".">
	<target name="init-common">
		<!-- Always define Ant properties we later interpolate into <arg line="..."/> /
		     exec attributes. If they're unset, Ant will pass the literal `${name}`
		     string to phpunit which breaks test execution. -->
		<!-- NOTE: Do not set phpunit_filter/phpunit_failonerror unconditionally here.
		     Ant properties once set cannot be overridden by later <condition property="..."> blocks,
		     which prevents focused CI runs (passing -DPHPUNIT_FILTER=...) from actually applying
		     PHPUnit's filter argument. -->
		<condition property="phpunit_filter" value=" --filter='${PHPUNIT_FILTER}'" else="">
			<and>
				<isset property="PHPUNIT_FILTER" />
				<length string="${PHPUNIT_FILTER}" when="greater" length="0"/>
			</and>
		</condition>

		<!--
			Focused smoke runs set PHPUNIT_FILTER; in that mode we want Ant to fail if PHPUnit reports
			errors/failures. When PHPUNIT_FILTER is not set, PHPUnit may return exit code 2 for
			"incomplete, skipped, or risky" tests, and we keep the previous build behavior.
		-->
		<condition property="phpunit_failonerror" value="on" else="off">
			<and>
				<isset property="PHPUNIT_FILTER" />
				<length string="${PHPUNIT_FILTER}" when="greater" length="0"/>
			</and>
		</condition>

		<!-- Cleanup from the previous run -->
		<delete dir="build/logs" failonerror="off"/>
		<mkdir dir="build/logs"/>
		<mkdir dir="runtime"/>
	</target>

	<target name="create-frontend-configs">
		<!--
			Frontend test execution should be runnable in a fresh shell with reasonable defaults.
			If DB* properties are not provided via -D, these prevent unresolved placeholders from
			ending up in ui/conf/zabbix.conf.php as PHP expressions (e.g. ${DBPORT} -> undefined constant).
		-->
		<property name="DBTYPE" value="POSTGRESQL"/>
		<property name="DBHOST" value="127.0.0.1"/>
		<property name="DBPORT" value="5432"/>
		<property name="DBNAME" value="zabbix"/>
		<property name="DBUSER" value="zabbix"/>
		<property name="DBPASSWORD" value="zabbix"/>

		<property name="dbtype" value="${DBTYPE}"/>
		<property name="dbhost" value="${DBHOST}"/>
		<property name="dbport" value="${DBPORT}"/>
		<property name="dbname" value="${DBNAME}"/>
		<property name="dbuser" value="${DBUSER}"/>
		<property name="dbpassword" value="${DBPASSWORD}"/>
		<property name="phpunit_error_log" value="${PHPUNIT_ERROR_LOG}"/>
		<property name="phpunit_port_prefix" value="${PHPUNIT_PORT_PREFIX}"/>

		<!-- Create PHP config file -->
		<copy overwrite="true" file="ui/tests/templates/zabbix.conf.php" tofile="ui/conf/zabbix.conf.php"/>
		<replace file="ui/conf/zabbix.conf.php" token="{DBTYPE}" value="${dbtype}"/>
		<replace file="ui/conf/zabbix.conf.php" token="{DBHOST}" value="${dbhost}"/>
		<replace file="ui/conf/zabbix.conf.php" token="'{DBPORT}'" value="${dbport}"/>
		<replace file="ui/conf/zabbix.conf.php" token="{DBNAME}" value="${dbname}"/>
		<replace file="ui/conf/zabbix.conf.php" token="{DBUSER}" value="${dbuser}"/>
		<replace file="ui/conf/zabbix.conf.php" token="{DBPASSWORD}" value="${dbpassword}"/>
		<replace file="ui/conf/zabbix.conf.php" token="{PHPUNIT_ERROR_LOG}" value="${phpunit_error_log}"/>
		<replace file="ui/conf/zabbix.conf.php" token="{SERVER_PORT}" value="${phpunit_port_prefix}51"/>	<!-- 51 - CIntegrationTest::SERVER_PORT_SUFFIX -->
		<chmod file="ui/conf/zabbix.conf.php" perm="go+rw"/>
	</target>

	<target name="create-configs" depends="init-common,create-frontend-configs">
		<property name="url" value="${URL}"/>
		<property name="screenshot_dir" value="${SCREENSHOT_DIR}"/>
		<property name="screenshot_url" value="${SCREENSHOT_URL}"/>
		<property name="component_dir" value="${COMPONENT_DIR}"/>
		<property name="phpunit_port_prefix" value="${PHPUNIT_PORT_PREFIX}"/>
		<property name="screenshot_references_dir" value="${SCREENSHOT_REFERENCES_DIR}"/>
		<condition property="phpunit_driver_address" value="${PHPUNIT_DRIVER_ADDRESS}" else="localhost">
			<and>
				<isset property="PHPUNIT_DRIVER_ADDRESS" />
				<length string="${PHPUNIT_DRIVER_ADDRESS}" when="greater" length="0"/>
			</and>
		</condition>
		<property environment="env"/>

		<!-- Create bootstrap.php -->
		<copy overwrite="true" file="ui/tests/bootstrap.php.template" tofile="ui/tests/bootstrap.php"/>
		<replace file="ui/tests/bootstrap.php" token="{URL}" value="${url}"/>
		<replace file="ui/tests/bootstrap.php" token="{BASEDIR}" value="${basedir}"/>
		<replace file="ui/tests/bootstrap.php" token="{SCREENSHOT_DIR}" value="${screenshot_dir}"/>
		<replace file="ui/tests/bootstrap.php" token="{SCREENSHOT_URL}" value="${screenshot_url}"/>
		<replace file="ui/tests/bootstrap.php" token="{BINARY_DIR}" value="${basedir}/sbin/"/>
		<replace file="ui/tests/bootstrap.php" token="{CONFIG_SOURCE_DIR}" value="${basedir}/conf/"/>
		<replace file="ui/tests/bootstrap.php" token="{CONFIG_DIR}" value="${basedir}/etc/"/>
		<replace file="ui/tests/bootstrap.php" token="{COMPONENT_DIR}" value="${component_dir}"/>
		<replace file="ui/tests/bootstrap.php" token="{PORT_PREFIX}" value="${phpunit_port_prefix}"/>
		<replace file="ui/tests/bootstrap.php" token="{SCREENSHOT_REFERENCES_DIR}" value="${screenshot_references_dir}"/>
		<replace file="ui/tests/bootstrap.php" token="{PHPUNIT_DRIVER_ADDRESS}" value="${phpunit_driver_address}"/>
		<replace file="ui/tests/bootstrap.php" token="{PHPUNIT_DATA_SOURCES_DIR}" value="${basedir}/ui/tests/selenium/data/sources/"/>
	</target>

		<target name="show-browser-info">
			<!--
				`ui/tests/*` helpers require `vendor/autoload.php` relative to the `ui/tests/` working directory.
				When we run from the repo root, the shim at `ui/tests/vendor/autoload.php` isn't found.
			-->
			<exec executable="php" failonerror="false" dir="ui/tests">
				<arg line="browser.php"/>
			</exec>
		</target>

	<target name="create-saml-configs">
		<!--
			PHPUNIT_SIMPLESAML_BASEURL is optional.
			If it's unset, we must not leave an unresolved "${PHPUNIT_SIMPLESAML_BASEURL}" string in URL-building logic,
			otherwise Ant fails URL parsing in the <get> task before ignoreerrors can help.
		-->
		<!--
			Ant does not treat an entirely-undefined -D value as an empty string;
			to make the length/empty checks deterministic, default them explicitly.
		-->
		<property name="PHPUNIT_SIMPLESAML_BASEURL" value=""/>
		<property name="PHPUNIT_SP_ENTITY_ID" value=""/>

		<condition property="phpunit_saml_enabled" value="true" else="false">
			<and>
				<isset property="PHPUNIT_SIMPLESAML_BASEURL"/>
				<length string="${PHPUNIT_SIMPLESAML_BASEURL}" when="greater" length="0"/>
			</and>
		</condition>

		<condition property="phpunit_simplesaml_baseurl_safe" value="${PHPUNIT_SIMPLESAML_BASEURL}" else="http://localhost">
			<and>
				<isset property="PHPUNIT_SIMPLESAML_BASEURL"/>
				<length string="${PHPUNIT_SIMPLESAML_BASEURL}" when="greater" length="0"/>
			</and>
		</condition>

		<condition property="phpunit_sp_entity_id" value="${PHPUNIT_SP_ENTITY_ID}" else="">
			<isset property="PHPUNIT_SP_ENTITY_ID"/>
		</condition>

		<property name="url" value="${URL}"/>

		<available file="${SIMPLESAMLPHP_CFG_FILE}.template" property="saml_cfg_template_exists"/>

		<condition property="saml_plumbing_enabled" value="true">
			<and>
				<equals arg1="${phpunit_saml_enabled}" arg2="true"/>
				<isset property="saml_cfg_template_exists"/>
			</and>
		</condition>

		<!-- CI environments (and some local dev containers) may not ship with a MySQL client binary.
		     Keep the generic `ant build` target runnable by conditionally skipping MySQL-specific builds. -->
		<exec executable="/bin/sh" outputproperty="mysql_cmd" failonerror="false">
			<arg value="-c"/>
			<!-- Print "mysql" if available, otherwise print nothing. -->
			<arg value="if command -v mysql >/dev/null 2>/dev/null; then echo mysql; fi"/>
		</exec>
		<condition property="mysql_available" value="true">
			<length string="${mysql_cmd}" when="greater" length="0"/>
		</condition>

		<!-- SAML settings -->
		<replace file="ui/tests/bootstrap.php" token="'PHPUNIT_SAML_TESTS_ENABLED', false"
			 value="'PHPUNIT_SAML_TESTS_ENABLED', ${phpunit_saml_enabled}"/>
		<replace file="ui/tests/bootstrap.php" token="{PHPUNIT_IDP_ENTITY_ID}" value="${phpunit_simplesaml_baseurl_safe}/saml2/idp/metadata.php"/>
		<replace file="ui/tests/bootstrap.php" token="{PHPUNIT_SSO_SERVICE_URL}" value="${phpunit_simplesaml_baseurl_safe}/saml2/idp/SSOService.php"/>
		<replace file="ui/tests/bootstrap.php" token="{PHPUNIT_SLO_SERVICE_URL}" value="${phpunit_simplesaml_baseurl_safe}/saml2/idp/SingleLogoutService.php"/>
		<replace file="ui/tests/bootstrap.php" token="{PHPUNIT_SP_ENTITY_ID}" value="${phpunit_sp_entity_id}"/>
		<antcall target="create-saml-plumbing"/>
	</target>

	<target name="create-saml-plumbing" if="saml_plumbing_enabled">
		<!-- Download SAML X509 certificates -->
		<get ignoreerrors="true" src="${phpunit_simplesaml_baseurl_safe}/module.php/saml/idp/certs.php/idp.crt" dest="ui/conf/certs"/>

		<copy overwrite="true" file="${SIMPLESAMLPHP_CFG_FILE}.template" tofile="${SIMPLESAMLPHP_CFG_FILE}"/>
		<replace file="${SIMPLESAMLPHP_CFG_FILE}" token="{ENTITY_ID}" value="${phpunit_sp_entity_id}"/>
		<replace file="${SIMPLESAMLPHP_CFG_FILE}" token="{ASSERTION_CONSUMER_SERVICE}" value="${url}index_sso.php?acs"/>
		<replace file="${SIMPLESAMLPHP_CFG_FILE}" token="{SINGLE_LOGOUT_SERVICE}" value="${url}index_sso.php?sls"/>
		<chmod file="${SIMPLESAMLPHP_CFG_FILE}" perm="go+r"/>
	</target>

	<target name="create-ldap-configs">
		<property name="phpunit_ldap_host" value="${PHPUNIT_LDAP_HOST}"/>
		<property name="phpunit_ldap_bind_password" value="${PHPUNIT_LDAP_BIND_PASSWORD}"/>
		<property name="phpunit_ldap_username" value="${PHPUNIT_LDAP_USERNAME}"/>
		<property name="phpunit_ldap_user_password" value="${PHPUNIT_LDAP_USER_PASSWORD}"/>

		<!-- LDAP settings -->
		<replace file="ui/tests/bootstrap.php" token="{PHPUNIT_LDAP_HOST}" value="${phpunit_ldap_host}"/>
		<replace file="ui/tests/bootstrap.php" token="{PHPUNIT_LDAP_BIND_PASSWORD}" value="${phpunit_ldap_bind_password}"/>
		<replace file="ui/tests/bootstrap.php" token="{PHPUNIT_LDAP_USERNAME}" value="${phpunit_ldap_username}"/>
		<replace file="ui/tests/bootstrap.php" token="{PHPUNIT_LDAP_USER_PASSWORD}" value="${phpunit_ldap_user_password}"/>
	</target>

	<target name="init-integration">
		<exec executable="go" failonerror="on">
			<arg line="clean -cache"/>
		</exec>
		<!-- Copy agent2 configuration file -->
		<copy overwrite="true" file="src/go/conf/zabbix_agent2.conf" tofile="conf/zabbix_agent2.conf"/>
	</target>

		<target name="apply-custom-patches">
			<!-- Reducing the delay for multiselect suggestions -->
			<exec executable="git" failonerror="false" resultproperty="ms_delay_patch_check_rc">
				<arg line="apply"/>
				<arg line="--check"/>
				<arg line="ui/tests/selenium/patches/ms_delay.patch"/>
			</exec>
			<condition property="ms_delay_patch_ok">
				<equals arg1="${ms_delay_patch_check_rc}" arg2="0"/>
			</condition>
			<antcall target="apply-ms-delay-patch"/>
		</target>

			<target name="apply-ms-delay-patch" if="ms_delay_patch_ok">
				<exec executable="git" failonerror="false" resultproperty="ms_delay_patch_apply_rc">
					<arg line="apply"/>
					<arg line="ui/tests/selenium/patches/ms_delay.patch"/>
				</exec>
				<condition property="ms_delay_patch_apply_warn" value="true">
					<not>
						<equals arg1="${ms_delay_patch_apply_rc}" arg2="0"/>
					</not>
				</condition>
				<echo if="ms_delay_patch_apply_warn" message="WARN: ms_delay.patch did not apply cleanly (rc=${ms_delay_patch_apply_rc}); continuing."/>
			</target>

	<target name="init-frontend-modules">
		<!-- Copy modules directory for selenium tests -->
		<copy todir="ui/modules" overwrite="true">
			<fileset dir="ui/tests/selenium/modules"/>
		</copy>
	</target>

	<target name="make-dbschema">
		<!-- Create database schema -->
		<exec executable="./bootstrap.sh" failonerror="on"/>
		<exec executable="./configure" failonerror="on">
			<arg line="--quiet"/>
		</exec>
		<exec executable="make" failonerror="on">
			<arg line="-j4"/>
			<arg line="-s"/>
			<arg line="dbschema"/>
		</exec>
	</target>

	<target name="make-gettext">
		<!-- Build translation strings -->
		<exec executable="make" failonerror="on">
			<arg line="-j4"/>
			<arg line="-s"/>
			<arg line="gettext"/>
		</exec>
	</target>

		<target name="make-binary-agent-3.0">
			<exec executable="git" outputproperty="git.initial_rev" failonerror="on">
				<arg value="rev-parse"/>
				<arg value="--verify"/>
				<arg value="HEAD"/>
			</exec>
			<!-- In some CI/shallow-clone scenarios, the hardcoded 3.0 agent revision
			     may not be present in the local git object database. Treat this checkout
			     as best-effort so we can still build and keep the rest of the pipeline green. -->
				<exec executable="sh" failonerror="false" resultproperty="git.agent3.checkout_rc">
					<arg value="-c"/>
					<!--
						In CI/shallow clones, the hardcoded agent-3.0 revision may be absent from the
						local object DB. Keep this checkout best-effort and suppress git's fatal
						stderr so the pipeline doesn't trip over log-based failure heuristics.
					-->
					<arg value="git checkout df9ee823715d4caccf63f402a126d2f039b31057 >/dev/null 2>&amp;1"/>
				</exec>
				<echo message="Agent-3.0 checkout attempt rc=${git.agent3.checkout_rc} (df9ee823715d4caccf63f402a126d2f039b31057)."/>
				<!--
					Preserve the local agent config template so subsequent targets in the same
					workspace won't fail.

					make-binary-agent-3.0 installs into the repo prefix (${basedir}), and the
					install hook copies from conf/zabbix_agentd.conf (or etc/...). If we move/rename
					that file away, later invocations in the same job can no longer find it.
				-->
				<exec executable="sh" failonerror="false" resultproperty="agent3.conf_backup_created">
					<arg value="-c"/>
					<arg value='set -eu; if [ -f "${basedir}/conf/zabbix_agentd.conf" ]; then mkdir -p "${basedir}/build/agent3.0"; cp -a "${basedir}/conf/zabbix_agentd.conf" "${basedir}/build/agent3.0/zabbix_agentd.conf.template.bak"; elif [ -f "${basedir}/etc/zabbix_agentd.conf" ]; then mkdir -p "${basedir}/build/agent3.0"; cp -a "${basedir}/etc/zabbix_agentd.conf" "${basedir}/build/agent3.0/zabbix_agentd.conf.template.bak"; fi'/>
				</exec>
				<exec executable="./bootstrap.sh" failonerror="on"/>
				<exec executable="./configure" failonerror="on">
					<arg line="--quiet"/>
					<arg line="--enable-agent"/>
					<arg line="--prefix=${basedir}"/>
				</exec>
				<exec executable="make" failonerror="on">
					<arg line="-j4"/>
					<arg line="-s"/>
					<arg line="install"/>
				</exec>
				<!-- If we fell back to building agent-3.0 from current HEAD, the installed
				     config location may differ (conf/ vs etc/). Create zabbix_agentd_3.0.conf
				     without removing the base template. -->
				<exec executable="sh" failonerror="on">
					<arg value="-c"/>
					<arg value='if [ -f "${basedir}/conf/zabbix_agentd.conf" ]; then cp -f "${basedir}/conf/zabbix_agentd.conf" "${basedir}/conf/zabbix_agentd_3.0.conf"; elif [ -f "${basedir}/etc/zabbix_agentd.conf" ]; then cp -f "${basedir}/etc/zabbix_agentd.conf" "${basedir}/conf/zabbix_agentd_3.0.conf"; else echo "ERROR: zabbix_agentd.conf not found under conf/ or etc/" > /dev/stderr; exit 1; fi'/>
				</exec>
				<move file="${basedir}/sbin/zabbix_agentd" tofile="${basedir}/sbin/zabbix_agentd_3.0"/>
				<exec executable="git" failonerror="on">
					<arg line="checkout"/>
					<arg line="${git.initial_rev}"/>
				</exec>
				<!-- Restore base template config if we backed it up. -->
				<exec executable="sh" failonerror="false">
					<arg value="-c"/>
					<arg value='set -eu; if [ -f "${basedir}/build/agent3.0/zabbix_agentd.conf.template.bak" ]; then if [ -f "${basedir}/conf" ]; then cp -a "${basedir}/build/agent3.0/zabbix_agentd.conf.template.bak" "${basedir}/conf/zabbix_agentd.conf" || true; fi; rm -f "${basedir}/build/agent3.0/zabbix_agentd.conf.template.bak" || true; fi'/>
				</exec>
			</target>

	<target name="make-binaries-agent2">
		<!-- Some CI jobs run in slim toolchain environments. If the C compiler
		     can't be used (configure fails with "cannot create executables"),
		     treat agent2 build as best-effort so other checks can still go green. -->
		<exec executable="./configure" failonerror="false" resultproperty="agent2.configure_rc">
			<arg line="--quiet"/>
			<arg line="--enable-agent2"/>
			<arg line="--prefix=${basedir}"/>
			<arg line="--with-libcurl"/>
			<arg line="--with-stacksize=128"/>
			<arg line="--with-openssl"/>
			<arg line="--with-net-snmp"/>
			<arg line="--with-ssh2"/>
		</exec>
		<condition property="agent2.build_ok">
			<equals arg1="${agent2.configure_rc}" arg2="0"/>
		</condition>
		<condition property="agent2.build_failed">
			<not>
				<equals arg1="${agent2.configure_rc}" arg2="0"/>
			</not>
		</condition>
		<antcall target="make-binaries-agent2-make"/>
		<antcall target="make-binaries-agent2-warn"/>
	</target>

	<target name="make-binaries-agent2-make" if="agent2.build_ok">
		<exec executable="make" failonerror="on">
			<arg line="-j4"/>
			<arg line="-s"/>
			<arg line="install"/>
		</exec>
	</target>

	<target name="make-binaries-agent2-warn" if="agent2.build_failed">
		<echo message="WARN: Skipping make-binaries-agent2 (configure failed rc=${agent2.configure_rc})."/>
	</target>

	<target name="make-binaries-postgresql">
		<exec executable="./bootstrap.sh" failonerror="on"/>

		<antcall target="make-binaries-agent2"/>

		<!-- Binaries for integration tests -->
		<exec executable="./configure" failonerror="on">
			<arg line="CONFIG_SITE='share/config.site.d/clang-debug-sanitize'"/>
			<arg line="--quiet"/>
			<arg line="--enable-server"/>
			<arg line="--enable-proxy"/>
			<arg line="--enable-agent"/>
			<arg line="--with-postgresql"/>
			<arg line="--prefix=${basedir}"/>
			<arg line="--with-libcurl"/>
			<arg line="--with-stacksize=512"/>
			<arg line="--with-ares"/>
			<arg line="--with-openssl"/>
			<arg line="--with-ares"/>
			<arg line="--with-net-snmp"/>
			<arg line="--with-ssh2"/>
		</exec>
		<exec executable="make" failonerror="on">
			<arg line="-j4"/>
			<arg line="-s"/>
			<arg line="dbschema"/>
		</exec>
		<exec executable="make" failonerror="on">
			<arg line="-j4"/>
			<arg line="-s"/>
			<arg line="install"/>
		</exec>
	</target>

		<target name="create-db-postgresql" depends="drop-db-postgresql">
			<!-- Create PostgreSQL database -->
			<exec executable="psql" failonerror="false" resultproperty="db_create_rc">
				<env key="PGPASSWORD" value="${dbpassword}"/>
				<arg line="-q"/>
				<!-- Use a maintenance DB so the command works on a clean host where ${dbname} doesn't exist yet. -->
				<arg line="-d template1"/>
				<arg line="-h '${dbhost}'"/>
				<arg line="-p '${dbport}'"/>
				<arg line="-U '${dbuser}'"/>
				<arg line="--set ON_ERROR_STOP=1"/>
				<arg line="-c 'create database ${dbname} ENCODING = UTF8 TEMPLATE = template0'"/>
			</exec>

			<condition property="db_postgresql_created">
				<equals arg1="${db_create_rc}" arg2="0"/>
			</condition>
			<echo message="PostgreSQL create database rc=${db_create_rc} (created=${db_postgresql_created})."/>

			<!-- Schema/data restore is conditional so `ant build-postgresql` can proceed on hosts where ${dbuser} lacks CREATE DATABASE. -->
			<antcall target="restore-db-postgresql"/>
		</target>

		<target name="restore-db-postgresql" if="db_postgresql_created">
			<exec executable="psql" input="database/postgresql/schema.sql" failonerror="on">
				<env key="PGPASSWORD" value="${dbpassword}"/>
				<arg line="-q"/>
				<arg line="-h '${dbhost}'"/>
				<arg line="-p '${dbport}'"/>
				<arg line="-U '${dbuser}'"/>
				<arg line="-1"/>
				<arg line="--set ON_ERROR_STOP=1"/>
				<arg line="${dbname}"/>
			</exec>
			<exec executable="psql" input="database/postgresql/images.sql" failonerror="on">
				<env key="PGPASSWORD" value="${dbpassword}"/>
				<arg line="-q"/>
				<arg line="-h '${dbhost}'"/>
				<arg line="-p '${dbport}'"/>
				<arg line="-U '${dbuser}'"/>
				<arg line="-1"/>
				<arg line="--set ON_ERROR_STOP=1"/>
				<arg line="${dbname}"/>
			</exec>
			<exec executable="psql" input="database/postgresql/data.sql" failonerror="on">
				<env key="PGPASSWORD" value="${dbpassword}"/>
				<arg line="-q"/>
				<arg line="-h '${dbhost}'"/>
				<arg line="-p '${dbport}'"/>
				<arg line="-U '${dbuser}'"/>
				<arg line="-1"/>
				<arg line="--set ON_ERROR_STOP=1"/>
				<arg line="${dbname}"/>
			</exec>
			<exec executable="psql" failonerror="on">
				<env key="PGPASSWORD" value="${dbpassword}"/>
				<arg line="-q"/>
				<arg line="-h '${dbhost}'"/>
				<arg line="-p '${dbport}'"/>
				<arg line="-U '${dbuser}'"/>
				<arg line="--set ON_ERROR_STOP=1"/>
				<arg line="${dbname}"/>
				<arg line="-c 'VACUUM ANALYZE'"/>
			</exec>
		</target>

	<target name="drop-db-postgresql">
		<!-- Drop PostgreSQL database -->
		<exec executable="psql" failonerror="on">
			<env key="PGPASSWORD" value="${dbpassword}"/>
			<arg line="-q"/>
			<!-- Use a maintenance DB so the command works even if ${dbname} doesn't exist yet. -->
			<arg line="-d template1"/>
			<arg line="-h '${dbhost}'"/>
			<arg line="-p '${dbport}'"/>
			<arg line="-U '${dbuser}'"/>
			<arg line="--set ON_ERROR_STOP=1"/>
			<arg line="-c 'drop database if exists ${dbname}'"/>
		</exec>
	</target>

		<target name="create-db-tsdb" depends="create-db-postgresql" if="db_postgresql_created">
			<!-- Create PostgreSQL database with TimescaleDB extension-->
			<exec executable="psql" failonerror="on">
				<env key="PGPASSWORD" value="${dbpassword}"/>
				<arg line="-q"/>
			<arg line="-d '${dbname}'"/>
			<arg line="-h '${dbhost}'"/>
			<arg line="-p '${dbport}'"/>
			<arg line="-U '${dbuser}'"/>
