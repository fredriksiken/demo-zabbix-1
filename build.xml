<?xml version="1.0" encoding="UTF-8"?>
<project name="Zabbix" default="build" basedir=".">
	<target name="init-common">
		<condition property="phpunit_filter" value=" --filter='${PHPUNIT_FILTER}'" else="">
			<and>
				<isset property="PHPUNIT_FILTER" />
				<length string="${PHPUNIT_FILTER}" when="greater" length="0"/>
			</and>
		</condition>
		<condition property="phpunit_filter_value" value="${PHPUNIT_FILTER}" else="">
			<and>
				<isset property="PHPUNIT_FILTER" />
				<length string="${PHPUNIT_FILTER}" when="greater" length="0"/>
			</and>
		</condition>
		<condition property="phpunit_bin" value="${PHPUNIT_BIN}" else="${basedir}/tools/phpunit">
			<and>
				<isset property="PHPUNIT_BIN" />
				<length string="${PHPUNIT_BIN}" when="greater" length="0"/>
			</and>
		</condition>
		<condition property="composer_bin" value="${COMPOSER_BIN}" else="${basedir}/tools/composer">
			<and>
				<isset property="COMPOSER_BIN" />
				<length string="${COMPOSER_BIN}" when="greater" length="0"/>
			</and>
		</condition>
		<condition property="frontend_webserver_bin" value="${FRONTEND_WEBSERVER_BIN}" else="${basedir}/tools/frontend-webserver">
			<and>
				<isset property="FRONTEND_WEBSERVER_BIN" />
				<length string="${FRONTEND_WEBSERVER_BIN}" when="greater" length="0"/>
			</and>
		</condition>
		<condition property="frontend_webdriver_bin" value="${FRONTEND_WEBDRIVER_BIN}" else="${basedir}/tools/frontend-webdriver">
			<and>
				<isset property="FRONTEND_WEBDRIVER_BIN" />
				<length string="${FRONTEND_WEBDRIVER_BIN}" when="greater" length="0"/>
			</and>
		</condition>

		<!-- Cleanup from the previous run -->
		<delete dir="build/logs" failonerror="off"/>
		<mkdir dir="build/logs"/>
		<mkdir dir="runtime"/>
	</target>

	<target name="create-frontend-configs">
		<condition property="dbtype" value="${DBTYPE}" else="POSTGRESQL">
			<and>
				<isset property="DBTYPE" />
				<length string="${DBTYPE}" when="greater" length="0"/>
			</and>
		</condition>
		<condition property="dbhost" value="${DBHOST}" else="127.0.0.1">
			<and>
				<isset property="DBHOST" />
				<length string="${DBHOST}" when="greater" length="0"/>
			</and>
		</condition>
		<condition property="dbport" value="${DBPORT}" else="5432">
			<and>
				<isset property="DBPORT" />
				<length string="${DBPORT}" when="greater" length="0"/>
			</and>
		</condition>
		<condition property="dbname" value="${DBNAME}" else="zabbix">
			<and>
				<isset property="DBNAME" />
				<length string="${DBNAME}" when="greater" length="0"/>
			</and>
		</condition>
		<condition property="dbuser" value="${DBUSER}" else="zabbix">
			<and>
				<isset property="DBUSER" />
				<length string="${DBUSER}" when="greater" length="0"/>
			</and>
		</condition>
		<condition property="dbpassword" value="${DBPASSWORD}" else="zabbix">
			<and>
				<isset property="DBPASSWORD" />
				<length string="${DBPASSWORD}" when="greater" length="0"/>
			</and>
		</condition>
		<condition property="frontend.default_postgresql_bare_shell">
			<and>
				<equals arg1="${dbtype}" arg2="POSTGRESQL"/>
				<equals arg1="${dbhost}" arg2="127.0.0.1"/>
				<equals arg1="${dbport}" arg2="5432"/>
				<equals arg1="${dbname}" arg2="zabbix"/>
				<equals arg1="${dbuser}" arg2="zabbix"/>
				<equals arg1="${dbpassword}" arg2="zabbix"/>
				<not>
					<or>
						<isset property="DBTYPE"/>
						<isset property="DBHOST"/>
						<isset property="DBPORT"/>
						<isset property="DBNAME"/>
						<isset property="DBUSER"/>
						<isset property="DBPASSWORD"/>
					</or>
				</not>
			</and>
		</condition>
		<condition property="phpunit_error_log" value="${PHPUNIT_ERROR_LOG}" else="/tmp/zbx-phpunit-errors.log">
			<and>
				<isset property="PHPUNIT_ERROR_LOG" />
				<length string="${PHPUNIT_ERROR_LOG}" when="greater" length="0"/>
			</and>
		</condition>
		<condition property="phpunit_port_prefix" value="${PHPUNIT_PORT_PREFIX}" else="19">
			<and>
				<isset property="PHPUNIT_PORT_PREFIX" />
				<length string="${PHPUNIT_PORT_PREFIX}" when="greater" length="0"/>
			</and>
		</condition>

		<!-- Create PHP config file -->
		<copy overwrite="true" file="ui/tests/templates/zabbix.conf.php" tofile="ui/conf/zabbix.conf.php"/>
		<replace file="ui/conf/zabbix.conf.php" token="{DBTYPE}" value="${dbtype}"/>
		<replace file="ui/conf/zabbix.conf.php" token="{DBHOST}" value="${dbhost}"/>
		<replace file="ui/conf/zabbix.conf.php" token="'{DBPORT}'" value="${dbport}"/>
		<replace file="ui/conf/zabbix.conf.php" token="{DBNAME}" value="${dbname}"/>
		<replace file="ui/conf/zabbix.conf.php" token="{DBUSER}" value="${dbuser}"/>
		<replace file="ui/conf/zabbix.conf.php" token="{DBPASSWORD}" value="${dbpassword}"/>
		<replace file="ui/conf/zabbix.conf.php" token="{PHPUNIT_ERROR_LOG}" value="${phpunit_error_log}"/>
		<replace file="ui/conf/zabbix.conf.php" token="{SERVER_PORT}" value="${phpunit_port_prefix}51"/>	<!-- 51 - CIntegrationTest::SERVER_PORT_SUFFIX -->
		<chmod file="ui/conf/zabbix.conf.php" perm="go+rw"/>
	</target>

	<target name="create-configs" depends="init-common,create-frontend-configs">
		<condition property="frontend.repo_webserver_required">
			<and>
				<isset property="frontend.default_postgresql_bare_shell"/>
				<not>
					<isset property="URL"/>
				</not>
			</and>
		</condition>
		<condition property="frontend_server_host" value="${FRONTEND_SERVER_HOST}" else="127.0.0.1">
			<and>
				<isset property="FRONTEND_SERVER_HOST" />
				<length string="${FRONTEND_SERVER_HOST}" when="greater" length="0"/>
			</and>
		</condition>
		<condition property="frontend_server_port" value="${FRONTEND_SERVER_PORT}" else="18080">
			<and>
				<isset property="FRONTEND_SERVER_PORT" />
				<length string="${FRONTEND_SERVER_PORT}" when="greater" length="0"/>
			</and>
		</condition>
		<condition property="default_url" value="http://${frontend_server_host}:${frontend_server_port}/"
				else="http://127.0.0.1/">
			<isset property="frontend.repo_webserver_required"/>
		</condition>
		<condition property="url" value="${URL}" else="${default_url}">
			<and>
				<isset property="URL" />
				<length string="${URL}" when="greater" length="0"/>
			</and>
		</condition>
		<condition property="screenshot_dir" value="${SCREENSHOT_DIR}" else="/tmp/zbx-screenshots">
			<and>
				<isset property="SCREENSHOT_DIR" />
				<length string="${SCREENSHOT_DIR}" when="greater" length="0"/>
			</and>
		</condition>
		<condition property="default_screenshot_url" value="http://${frontend_server_host}:${frontend_server_port}/screenshots/"
				else="http://127.0.0.1/screenshots/">
			<isset property="frontend.repo_webserver_required"/>
		</condition>
		<condition property="screenshot_url" value="${SCREENSHOT_URL}" else="${default_screenshot_url}">
			<and>
				<isset property="SCREENSHOT_URL" />
				<length string="${SCREENSHOT_URL}" when="greater" length="0"/>
			</and>
		</condition>
		<condition property="component_dir" value="${COMPONENT_DIR}" else="/tmp/zbx-components">
			<and>
				<isset property="COMPONENT_DIR" />
				<length string="${COMPONENT_DIR}" when="greater" length="0"/>
			</and>
		</condition>
		<condition property="phpunit_port_prefix" value="${PHPUNIT_PORT_PREFIX}" else="19">
			<and>
				<isset property="PHPUNIT_PORT_PREFIX" />
				<length string="${PHPUNIT_PORT_PREFIX}" when="greater" length="0"/>
			</and>
		</condition>
		<condition property="screenshot_references_dir" value="${SCREENSHOT_REFERENCES_DIR}" else="/tmp/zbx-screenshots-ref">
			<and>
				<isset property="SCREENSHOT_REFERENCES_DIR" />
				<length string="${SCREENSHOT_REFERENCES_DIR}" when="greater" length="0"/>
			</and>
		</condition>
		<condition property="phpunit_driver_address" value="${PHPUNIT_DRIVER_ADDRESS}" else="localhost">
			<and>
				<isset property="PHPUNIT_DRIVER_ADDRESS" />
				<length string="${PHPUNIT_DRIVER_ADDRESS}" when="greater" length="0"/>
			</and>
		</condition>
		<condition property="frontend.repo_webdriver_required">
			<and>
				<isset property="frontend.default_postgresql_bare_shell"/>
				<not>
					<isset property="PHPUNIT_DRIVER_ADDRESS"/>
				</not>
			</and>
		</condition>
		<property environment="env"/>
		<mkdir dir="${screenshot_dir}"/>
		<mkdir dir="${component_dir}"/>
		<mkdir dir="${screenshot_references_dir}"/>
		<exec executable="sh" failonerror="off" outputproperty="frontend.phpunit_target_path"
				resultproperty="frontend.phpunit_target_lookup_exit">
			<arg value="-c"/>
			<arg value="cd '${basedir}/ui' &amp;&amp; if [ -n '${phpunit_filter_value}' ]; then rg --files tests/general tests/selenium -g '${phpunit_filter_value}.php' | head -n 1; fi"/>
		</exec>
		<condition property="frontend.phpunit_target_found">
			<and>
				<equals arg1="${frontend.phpunit_target_lookup_exit}" arg2="0"/>
				<length string="${frontend.phpunit_target_path}" when="greater" length="0"/>
			</and>
		</condition>
		<condition property="frontend.phpunit_scope_arg" value="" else="--testsuite=frontend">
			<isset property="frontend.phpunit_target_found"/>
		</condition>
		<condition property="frontend.phpunit_target_arg" value="${frontend.phpunit_target_path}" else="">
			<isset property="frontend.phpunit_target_found"/>
		</condition>
		<condition property="frontend.clean_postgresql_frontend_fixtures_required">
			<and>
				<isset property="frontend.default_postgresql_bare_shell"/>
				<or>
					<equals arg1="${frontend.phpunit_target_path}" arg2="tests/selenium/testDocumentationLinks.php"/>
					<equals arg1="${phpunit_filter_value}" arg2="testDocumentationLinks"/>
				</or>
			</and>
		</condition>

		<!-- Create bootstrap.php -->
		<copy overwrite="true" file="ui/tests/bootstrap.php.template" tofile="ui/tests/bootstrap.php"/>
		<replace file="ui/tests/bootstrap.php" token="{URL}" value="${url}"/>
		<replace file="ui/tests/bootstrap.php" token="{BASEDIR}" value="${basedir}"/>
		<replace file="ui/tests/bootstrap.php" token="{SCREENSHOT_DIR}" value="${screenshot_dir}/"/>
		<replace file="ui/tests/bootstrap.php" token="{SCREENSHOT_URL}" value="${screenshot_url}"/>
		<replace file="ui/tests/bootstrap.php" token="{BINARY_DIR}" value="${basedir}/sbin/"/>
		<replace file="ui/tests/bootstrap.php" token="{CONFIG_SOURCE_DIR}" value="${basedir}/conf/"/>
		<replace file="ui/tests/bootstrap.php" token="{CONFIG_DIR}" value="${basedir}/etc/"/>
		<replace file="ui/tests/bootstrap.php" token="{COMPONENT_DIR}" value="${component_dir}/"/>
		<replace file="ui/tests/bootstrap.php" token="{PORT_PREFIX}" value="${phpunit_port_prefix}"/>
		<replace file="ui/tests/bootstrap.php" token="{SCREENSHOT_REFERENCES_DIR}" value="${screenshot_references_dir}/"/>
		<replace file="ui/tests/bootstrap.php" token="{PHPUNIT_DRIVER_ADDRESS}" value="${phpunit_driver_address}"/>
		<replace file="ui/tests/bootstrap.php" token="{PHPUNIT_DATA_SOURCES_DIR}" value="${basedir}/ui/tests/selenium/data/sources/"/>
	</target>

	<target name="install-ui-dependencies" depends="init-common" unless="ui.webdriver_available">
		<exec executable="${composer_bin}" failonerror="on">
			<arg line="install --working-dir=${basedir}/ui --no-interaction --prefer-dist --no-progress"/>
		</exec>
	</target>

	<target name="ensure-ui-webdriver" depends="init-common">
		<available file="ui/vendor/php-webdriver/webdriver/lib/Remote/RemoteWebElement.php"
				property="ui.webdriver_available"/>
		<antcall target="install-ui-dependencies" inheritAll="true"/>
	</target>

	<target name="ensure-frontend-webserver" depends="create-configs" if="frontend.repo_webserver_required">
		<echo message="Ensuring repo-managed frontend web server is available at ${url}"/>
		<exec executable="${frontend_webserver_bin}" failonerror="on">
			<env key="FRONTEND_SERVER_HOST" value="${frontend_server_host}"/>
			<env key="FRONTEND_SERVER_PORT" value="${frontend_server_port}"/>
			<env key="FRONTEND_SERVER_DOCROOT" value="${basedir}/ui"/>
			<env key="FRONTEND_SERVER_PID_FILE" value="${basedir}/runtime/frontend-webserver.pid"/>
			<env key="FRONTEND_SERVER_LOG_FILE" value="${basedir}/runtime/frontend-webserver.log"/>
			<arg value="start"/>
		</exec>
	</target>

	<target name="reset-frontend-session-storage" depends="create-configs"
			if="frontend.clean_postgresql_frontend_fixtures_required">
		<echo message="Clearing repo-local frontend session files before the shared documentation-link rerun."/>
		<mkdir dir="${basedir}/runtime/php-sessions"/>
		<delete failonerror="off" includeemptydirs="true">
			<fileset dir="${basedir}/runtime/php-sessions" includes="**/*"/>
		</delete>
	</target>

	<target name="ensure-frontend-webdriver" depends="create-configs" if="frontend.repo_webdriver_required">
		<echo message="Ensuring repo-managed frontend WebDriver is available at http://${phpunit_driver_address}:4444/wd/hub/status"/>
		<exec executable="${frontend_webdriver_bin}" failonerror="on">
			<env key="SELENIUM_STATUS_URL" value="http://${phpunit_driver_address}:4444/wd/hub/status"/>
			<arg value="start"/>
		</exec>
	</target>

	<target name="show-browser-info">
		<exec executable="php" failonerror="on">
			<arg line="ui/tests/browser.php"/>
		</exec>
	</target>

	<target name="create-saml-configs">
		<property name="phpunit_simplesaml_baseurl" value="${PHPUNIT_SIMPLESAML_BASEURL}"/>
		<property name="phpunit_sp_entity_id" value="${PHPUNIT_SP_ENTITY_ID}"/>
		<property name="url" value="${URL}"/>

		<!-- SAML settings -->
		<replace file="ui/tests/bootstrap.php" token="'PHPUNIT_SAML_TESTS_ENABLED', false" value="'PHPUNIT_SAML_TESTS_ENABLED', true"/>
		<replace file="ui/tests/bootstrap.php" token="{PHPUNIT_IDP_ENTITY_ID}" value="${phpunit_simplesaml_baseurl}/saml2/idp/metadata.php"/>
		<replace file="ui/tests/bootstrap.php" token="{PHPUNIT_SSO_SERVICE_URL}" value="${phpunit_simplesaml_baseurl}/saml2/idp/SSOService.php"/>
		<replace file="ui/tests/bootstrap.php" token="{PHPUNIT_SLO_SERVICE_URL}" value="${phpunit_simplesaml_baseurl}/saml2/idp/SingleLogoutService.php"/>
		<replace file="ui/tests/bootstrap.php" token="{PHPUNIT_SP_ENTITY_ID}" value="${phpunit_sp_entity_id}"/>
		<!-- Download SAML X509 certificates -->
		<get src="${phpunit_simplesaml_baseurl}/module.php/saml/idp/certs.php/idp.crt" dest="ui/conf/certs"/>

		<copy overwrite="true" file="${SIMPLESAMLPHP_CFG_FILE}.template" tofile="${SIMPLESAMLPHP_CFG_FILE}"/>
		<replace file="${SIMPLESAMLPHP_CFG_FILE}" token="{ENTITY_ID}" value="${phpunit_sp_entity_id}"/>
		<replace file="${SIMPLESAMLPHP_CFG_FILE}" token="{ASSERTION_CONSUMER_SERVICE}" value="${url}index_sso.php?acs"/>
		<replace file="${SIMPLESAMLPHP_CFG_FILE}" token="{SINGLE_LOGOUT_SERVICE}" value="${url}index_sso.php?sls"/>
		<chmod file="${SIMPLESAMLPHP_CFG_FILE}" perm="go+r"/>
	</target>

	<target name="create-ldap-configs">
		<property name="phpunit_ldap_host" value="${PHPUNIT_LDAP_HOST}"/>
		<property name="phpunit_ldap_bind_password" value="${PHPUNIT_LDAP_BIND_PASSWORD}"/>
		<property name="phpunit_ldap_username" value="${PHPUNIT_LDAP_USERNAME}"/>
		<property name="phpunit_ldap_user_password" value="${PHPUNIT_LDAP_USER_PASSWORD}"/>

		<!-- LDAP settings -->
		<replace file="ui/tests/bootstrap.php" token="{PHPUNIT_LDAP_HOST}" value="${phpunit_ldap_host}"/>
		<replace file="ui/tests/bootstrap.php" token="{PHPUNIT_LDAP_BIND_PASSWORD}" value="${phpunit_ldap_bind_password}"/>
		<replace file="ui/tests/bootstrap.php" token="{PHPUNIT_LDAP_USERNAME}" value="${phpunit_ldap_username}"/>
		<replace file="ui/tests/bootstrap.php" token="{PHPUNIT_LDAP_USER_PASSWORD}" value="${phpunit_ldap_user_password}"/>
	</target>

	<target name="init-integration">
		<exec executable="go" failonerror="on">
			<arg line="clean -cache"/>
		</exec>
		<!-- Copy agent2 configuration file -->
		<copy overwrite="true" file="src/go/conf/zabbix_agent2.conf" tofile="conf/zabbix_agent2.conf"/>
	</target>

	<target name="apply-custom-patches">
		<!-- Reducing the delay for multiselect suggestions -->
		<exec executable="git" failonerror="on">
			<arg line="apply"/>
			<arg line="ui/tests/selenium/patches/ms_delay.patch"/>
		</exec>
	</target>

	<target name="init-frontend-modules">
		<!-- Copy modules directory for selenium tests -->
		<copy todir="ui/modules" overwrite="true">
			<fileset dir="ui/tests/selenium/modules"/>
		</copy>
	</target>

	<target name="make-dbschema">
		<!-- Create database schema -->
		<exec executable="./bootstrap.sh" failonerror="on"/>
		<exec executable="./configure" failonerror="on">
			<arg line="--quiet"/>
		</exec>
		<exec executable="make" failonerror="on">
			<arg line="-j4"/>
			<arg line="-s"/>
			<arg line="dbschema"/>
		</exec>
	</target>

	<target name="make-gettext">
		<!-- Build translation strings -->
		<exec executable="make" failonerror="on">
			<arg line="-j4"/>
			<arg line="-s"/>
			<arg line="gettext"/>
		</exec>
	</target>

	<target name="make-binary-agent-3.0">
		<exec executable="git" outputproperty="git.initial_rev" failonerror="on">
			<arg value="rev-parse"/>
			<arg value="--verify"/>
			<arg value="HEAD"/>
		</exec>
		<exec executable="git" failonerror="on">
			<arg line="checkout"/>
			<arg line="df9ee823715d4caccf63f402a126d2f039b31057"/>
		</exec>
		<exec executable="./bootstrap.sh" failonerror="on"/>
		<exec executable="./configure" failonerror="on">
			<arg line="--quiet"/>
			<arg line="--enable-agent"/>
			<arg line="--prefix=${basedir}"/>
		</exec>
		<exec executable="make" failonerror="on">
			<arg line="-j4"/>
			<arg line="-s"/>
			<arg line="install"/>
		</exec>
		<move file="${basedir}/conf/zabbix_agentd.conf" tofile="${basedir}/conf/zabbix_agentd_3.0.conf"/>
		<move file="${basedir}/sbin/zabbix_agentd" tofile="${basedir}/sbin/zabbix_agentd_3.0"/>
		<exec executable="git" failonerror="on">
			<arg line="checkout"/>
			<arg line="${git.initial_rev}"/>
		</exec>
	</target>

	<target name="make-binaries-agent2">
		<exec executable="./configure" failonerror="on">
			<arg line="--quiet"/>
			<arg line="--enable-agent2"/>
			<arg line="--prefix=${basedir}"/>
			<arg line="--with-libcurl"/>
			<arg line="--with-stacksize=128"/>
			<arg line="--with-openssl"/>
			<arg line="--with-net-snmp"/>
			<arg line="--with-ssh2"/>
		</exec>
		<exec executable="make" failonerror="on">
			<arg line="-j4"/>
			<arg line="-s"/>
			<arg line="install"/>
		</exec>
	</target>

	<target name="make-binaries-postgresql">
		<exec executable="./bootstrap.sh" failonerror="on"/>

		<antcall target="make-binaries-agent2"/>

		<!-- Binaries for integration tests -->
		<exec executable="./configure" failonerror="on">
			<arg line="CONFIG_SITE='share/config.site.d/clang-debug-sanitize'"/>
			<arg line="--quiet"/>
			<arg line="--enable-server"/>
			<arg line="--enable-proxy"/>
			<arg line="--enable-agent"/>
			<arg line="--with-postgresql"/>
			<arg line="--prefix=${basedir}"/>
			<arg line="--with-libcurl"/>
			<arg line="--with-stacksize=512"/>
			<arg line="--with-ares"/>
			<arg line="--with-openssl"/>
			<arg line="--with-ares"/>
			<arg line="--with-net-snmp"/>
			<arg line="--with-ssh2"/>
		</exec>
		<exec executable="make" failonerror="on">
			<arg line="-j4"/>
			<arg line="-s"/>
			<arg line="dbschema"/>
		</exec>
		<exec executable="make" failonerror="on">
			<arg line="-j4"/>
			<arg line="-s"/>
			<arg line="install"/>
		</exec>
	</target>

	<target name="create-db-postgresql" depends="drop-db-postgresql">
		<!-- Create PostgreSQL database -->
		<exec executable="psql" failonerror="on">
			<env key="PGPASSWORD" value="${dbpassword}"/>
			<arg line="-q"/>
			<arg line="-d 'postgres'"/>
			<arg line="-h '${dbhost}'"/>
			<arg line="-p '${dbport}'"/>
			<arg line="-U '${dbuser}'"/>
			<arg line="--set ON_ERROR_STOP=1"/>
			<arg line="-c 'create database ${dbname} ENCODING = UTF8 TEMPLATE = template0'"/>
		</exec>
		<antcall target="load-db-postgresql-base" inheritAll="true"/>
	</target>

	<target name="load-db-postgresql-base">
		<exec executable="psql" input="database/postgresql/schema.sql" failonerror="on">
			<env key="PGPASSWORD" value="${dbpassword}"/>
			<arg line="-q"/>
			<arg line="-h '${dbhost}'"/>
			<arg line="-p '${dbport}'"/>
			<arg line="-U '${dbuser}'"/>
			<arg line="-1"/>
			<arg line="--set ON_ERROR_STOP=1"/>
			<arg line="${dbname}"/>
		</exec>
		<exec executable="psql" input="database/postgresql/images.sql" failonerror="on">
			<env key="PGPASSWORD" value="${dbpassword}"/>
			<arg line="-q"/>
			<arg line="-h '${dbhost}'"/>
			<arg line="-p '${dbport}'"/>
			<arg line="-U '${dbuser}'"/>
			<arg line="-1"/>
			<arg line="--set ON_ERROR_STOP=1"/>
			<arg line="${dbname}"/>
		</exec>
		<exec executable="psql" input="database/postgresql/data.sql" failonerror="on">
			<env key="PGPASSWORD" value="${dbpassword}"/>
			<arg line="-q"/>
			<arg line="-h '${dbhost}'"/>
			<arg line="-p '${dbport}'"/>
			<arg line="-U '${dbuser}'"/>
			<arg line="--set ON_ERROR_STOP=1"/>
			<arg line="${dbname}"/>
		</exec>
		<exec executable="psql" failonerror="on">
			<env key="PGPASSWORD" value="${dbpassword}"/>
			<arg line="-q"/>
			<arg line="-h '${dbhost}'"/>
			<arg line="-p '${dbport}'"/>
			<arg line="-U '${dbuser}'"/>
			<arg line="--set ON_ERROR_STOP=1"/>
			<arg line="${dbname}"/>
			<arg line="-c 'VACUUM ANALYZE'"/>
		</exec>
