{
	"manifest_version": 2.0,
	"id": "trafficlight",
	"type": "widget",
	"name": "Traffic light",
	"namespace": "TrafficLight",
	"version": "1.0",
	"author": "Zabbix",
	"description": "Aggregates latest numeric values of selected items into a worst-state traffic light (green/yellow/red).",
	"url": "web_interface/frontend_sections/dashboards/widgets/trafficlight",
	"widget": {
		"js_class": "CWidgetTrafficLight",
		"in": {
			"groupids": {
				"type": "_hostgroupids"
			},
			"hostids": {
				"type": "_hostids"
			}
		},
		"size": {
			"width": 18,
			"height": 4
		},
		"refresh_rate": 900
	},
	"actions": {
		"widget.trafficlight.view": {
			"class": "WidgetView"
		}
	},
	"assets": {
		"js": ["class.widget.js"]
	}
}

