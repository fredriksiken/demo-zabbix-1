{
	"manifest_version": 2.0,
	"id": "trafficlight",
	"type": "widget",
	"name": "Traffic Light",
	"namespace": "TrafficLight",
	"version": "1.0",
	"author": "Zabbix",
	"description": "Displays the latest numeric value of an item using configurable red/yellow/green thresholds.",
	"url": "web_interface/frontend_sections/dashboards/widgets/trafficlight",
	"widget": {
		"size": {
			"width": 6,
			"height": 3
		},
		"js_class": "CWidgetTrafficLight",
		"refresh_rate": 60
	},
	"actions": {
		"widget.trafficlight.view": {
			"class": "WidgetView"
		}
	},
	"assets": {
		"js": ["class.widget.js"]
	}
}

